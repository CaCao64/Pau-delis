<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/cb_tab_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/green_primary"/>

    <ImageView
        android:id="@+id/iv_tab_icon"
        android:layout_width="22dp" android:layout_height="22dp"
        android:layout_marginStart="12dp"/>

    <TextView
        android:id="@+id/tv_tab_label"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textSize="15sp"
        android:textColor="@color/text_primary"/>

    <!-- Handle de drag -->
    <ImageView
        android:id="@+id/iv_drag_handle"
        android:layout_width="32dp" android:layout_height="32dp"
        android:padding="4dp"
        android:src="@drawable/ic_drag_handle"
        android:alpha="0.4"/>

</LinearLayout>
